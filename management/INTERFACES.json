          "sensor": 1,
          "addr": "0x5B",
          "ADDR_pin": "to 3V3",
          "note": "breadboard only on PCB v1.0"
        }
      ],
      "pullups": "PCB: R13 (SCL) and R14 (SDA) 4.7 kOhm to +3V3; module: 10 k on the host side (to VIN/VCC) and 10 k on the MPR121 side (to 3.3 V) with BSS138 shifters (S-06/S-07); RP2040 internal pull-ups (S-09). Low-level sink 1.43 mA.",
      "logic_level_V": 3.3,
      "mpr121_config_written_by_library": {
        "CONFIG1": "0x10 (FFI 6, CDC 16 uA global)",
        "CONFIG2": "0x20 (CDT 0.5 us, SFI 4, ESI 1 ms)",
        "DEBOUNCE": "0x00",
        "ECR": "0x8C (CL=10, 12 electrodes, proximity off)",
        "AUTOCONFIG0": "0x0B (ACE+ARE, FFI 6) when AUTOCONFIG",
        "USL/TL/LSL": [
          200,
          180,
          130
        ],
        "touch/release threshold": [
          12,
          6
        ],
        "label": "SOURCE S-08",
        "AUTOCONFIG1": "0x7C SCTS (D7) = 0, written explicitly by firmware (ADR-010/011, SOURCE S-006)",
        "USL/TL/LSL_note": "design VDD 3.2 V (ADR-010), SOURCE S-006 formula"
      },
      "transactions": [
        "every loop, per sensor: touched() = readRegister16(0x00): write 1 B register, repeated start, read 2 B",
        "aftertouch pass (every 15 ms if any pad active), per sensor: for each run [lo, lo+n) of sounding electrodes (runs merged across gaps <= 1, fm::mpr121_next_run): readRegisters(addr, 0x04+2*lo, 2n B) and readRegisters(addr, 0x1E+lo, n B); worst case 42 bus bytes in 8 transactions (mask 0x925); all 12 pads = 24 B + 12 B",
        "debug only: filteredData(e) 2 B, baselineData(e) 1 B"
      ],
      "series_resistors": {
        "R15": "220 Ohm, SCL_PICO-SCL",
        "R16": "220 Ohm, SDA_PICO-SDA",
        "fault_current_mA": 15.5,
        "label": "CALCULATION at 3.4 V; <= IIOVDD_MAX 50 mA (S-17)"
      },
      "levels": {
